          "mode": "id",
          "value": "={{ $json.user }}"
        },
        "additionalFields": {
          "id": "=slack-{{ $json.channel }}-{{ $json.ts }}",
          "timestamp": "={{ DateTime.fromSeconds(Number($json.ts)).toUTC().toISO() }}",
          "label": "=Slack message in {{ $json.channel }}"
        }
      },
      "id": "92a54b2a-b636-5347-a077-9408865d4ecf",
      "name": "Save the message to memory",
