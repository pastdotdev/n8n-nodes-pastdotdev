      "typeVersion": 1,
      "position": [
        520,
        -100
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Slack message or mention').item.json.channel }}"
        },
        "text": "={{ $json.output }}",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "thread_ts": {
            "replyValues": {
              "thread_ts": "={{ $('Slack message or mention').item.json.thread_ts || $('Slack message or mention').item.json.ts }}"
            }
          }
        }
      },
      "id": "71648812-774c-56ce-bf7b-27d8398dc0e1",
      "name": "Reply in the thread",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        760,
        -320
      ],
      "webhookId": "56d6d9d3-fa65-546b-9277-9a6ae89a09e5"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5bf2ee18-60c1-5a85-ac60-670c9da21498",
              "leftValue": "={{ $json.bot_id }}",
              "operator": {
                "type": "string",
                "operation": "notExists",
                "singleValue": true
              },
              "rightValue": ""
            },
            {
              "id": "8e4477b1-cc5c-5e3b-b5b6-db131a97feff",
              "leftValue": "={{ $json.subtype }}",
              "operator": {
                "type": "string",
                "operation": "notExists",
                "singleValue": true
              },
              "rightValue": ""
            },
            {
              "id": "3d251140-fe9a-518f-8932-bc673b113cd8",
              "leftValue": "={{ $json.text }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "6174e47f-5030-571b-8d0d-7da632049912",
      "name": "Only messages from people",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        300,
        220
      ]
    },
    {
      "parameters": {
        "resource": "memory",
        "operation": "ingest",
        "content": "={{ $json.text }}",
        "identity": {
