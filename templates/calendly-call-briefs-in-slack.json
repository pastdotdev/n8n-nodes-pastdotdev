    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a brief for a call with {{ $('New Calendly booking').item.json.payload.name }} ({{ $('New Calendly booking').item.json.payload.email }}).\nMeeting: {{ $('New Calendly booking').item.json.payload.scheduled_event.name }}, {{ $('New Calendly booking').item.json.payload.scheduled_event.start_time }}\n\nUse only these memories. Give the date of each fact. Do not invent anything.\n\n{{ $json.context }}\n\nFormat for Slack, under 150 words:\n*Who*: one line\n*Last time*: up to 3 bullets\n*Open points and promises*: up to 3 bullets\n*Careful*: prices or facts that changed"
      },
      "id": "192f23d5-9bb1-5446-976b-a92fee05c816",
      "name": "Write the brief",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        780,
        -220
      ]
    },
