    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').item.json.slack_channel }}"
        },
        "text": "=:calendar: *Call with {{ $('New Calendly booking').item.json.payload.name }}* ({{ $('New Calendly booking').item.json.payload.email }}), {{ $('New Calendly booking').item.json.payload.scheduled_event.start_time }}\n\nNo history in memory yet. This is a first contact.",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
