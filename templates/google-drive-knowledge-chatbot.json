    {
      "parameters": {
        "jsCode": "// Split each document at paragraph boundaries, in parts under 32,000 characters.\nconst MAX = 30000;\nconst out = [];\n$input.all().forEach((item, index) => {\n  const text = (item.json.text || '').trim();\n  if (!text) return;\n  const parts = [];\n  let current = '';\n  for (const paragraph of text.split(/\\n\\s*\\n/)) {\n    const pieces = paragraph.length > MAX ? paragraph.match(new RegExp('[\\\\s\\\\S]{1,' + MAX + '}', 'g')) : [paragraph];\n    for (const piece of pieces) {\n      if (current && current.length + piece.length + 2 > MAX) { parts.push(current); current = ''; }\n      current = current ? current + '\\n\\n' + piece : piece;\n    }\n  }\n  if (current) parts.push(current);\n  const file = $('Download the file').itemMatching(index).json;\n  parts.forEach((content, i) => out.push({ json: {\n    content: 'Document: ' + file.name + '\\n\\n' + content,\n    sourceId: 'gdrive-' + file.id + (parts.length > 1 ? '.' + (i + 1) : ''),\n    label: file.name + (parts.length > 1 ? ' (part ' + (i + 1) + ')' : ''),\n    occurredAt: file.modifiedTime,\n  } }));\n});\nreturn out;"
      },
      "id": "93ad950e-97c1-5fb0-b8b7-65f719bfc9a1",
      "name": "Split long documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        -260
